{
    "name": "YELLOW LINE Dark 1",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "variable.defaultLibrary": "#fac80a",
        "variable.readonly": "#d4d4d4",
        "variable.local": "#d4d4d4",
        "variable.parameter": "#a8a8a8",
        "property": "#d4d4d4",
        "method": "#a8a8a8",
        "function": "#a8a8a8",
        "class": "#fac80a",
        "type": "#a8a8a8",
        "number": "#fac80a",
        "string": "#a8a8a8",
        "comment": "#4d4d4d",
        "keyword": "#fac80a",
        "enumMember": "#fac80a",
        "variable.constant": "#fac80a"
    },
    "tokenColors": [
        {
            "name": "Keywords (Directive)",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator",
                "keyword.other",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#fac80a"
            }
        },
        {
            "name": "Functions (concrete)",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#a8a8a8"
            }
        },
        {
            "name": "Classes and types (Directive)",
            "scope": [
                "entity.name.type.class",
                "entity.name.type.struct",
                "entity.name.type",
                "entity.name.class",
                "entity.name.class.identifier",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#fac80a"
            }
        },
        {
            "name": "Variables (lighter concrete)",
            "scope": [
                "variable",
                "variable.other",
                "entity.name.variable",
                "support.variable",
                "variable.other.readwrite",
                "meta.object-literal.key"
            ],
            "settings": {
                "foreground": "#d4d4d4"
            }
        },
        {
            "name": "this, super, booleans (Directive)",
            "scope": [
                "variable.language",
                "constant.language",
                "variable.language.this",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#fac80a"
            }
        },
        {
            "name": "Numbers (Directive)",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#fac80a"
            }
        },
        {
            "name": "Strings (concrete)",
            "scope": [
                "string",
                "string.quoted",
                "string.quoted.double",
                "string.quoted.single"
            ],
            "settings": {
                "foreground": "#a8a8a8"
            }
        },
        {
            "name": "Comments (whispers)",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#4d4d4d",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Tags and attributes (concrete)",
            "scope": [
                "entity.name.tag",
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#a8a8a8"
            }
        },
        {
            "name": "Punctuation (steel)",
            "scope": [
                "punctuation.definition.tag",
                "punctuation.separator.key-value",
                "punctuation.separator.delimiter",
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end"
            ],
            "settings": {
                "foreground": "#a8a8a8"
            }
        },
        {
            "name": "Errors (Reactor's Wrath)",
            "scope": [
                "invalid",
                "invalid.illegal",
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#ff4500"
            }
        }
    ],
